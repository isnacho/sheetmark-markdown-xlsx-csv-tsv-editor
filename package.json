{
    "name": "sheetmark",
    "displayName": "Sheetmark: XLSX, CSV, TSV & Markdown",
    "description": "Sheetmark — view and edit XLSX, CSV, TSV, and Markdown files in VS Code. Rich spreadsheet formatting, live-preview Markdown editing, and a native theme-aware UI.",
    "version": "1.0.0",
    "publisher": "nacho-allendesalazar",
    "engines": {
        "vscode": "^1.60.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nachosdesign/sheetmark-markdown-xlsx-csv-tsv-editor"
    },
    "bugs": {
        "url": "https://github.com/nachosdesign/sheetmark-markdown-xlsx-csv-tsv-editor/issues"
    },
    "homepage": "https://github.com/nachosdesign/sheetmark-markdown-xlsx-csv-tsv-editor",
    "keywords": [
        "markdown",
        "xlsx",
        "excel",
        "csv",
        "office",
        "tsv",
        "spreadsheet",
        "viewer",
        "editor",
        "xlsx-editor",
        "table-edit",
        "toolbar",
        "settings",
        "multiple sheets",
        "style",
        "fonts",
        "theme"
    ],
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "customEditors": [
            {
                "viewType": "xlsxViewer.xlsx",
                "displayName": "Sheetmark — XLSX",
                "selector": [
                    {
                        "filenamePattern": "*.xlsx"
                    }
                ]
            },
            {
                "viewType": "xlsxViewer.csv",
                "displayName": "Sheetmark — CSV",
                "selector": [
                    {
                        "filenamePattern": "*.csv"
                    }
                ]
            },
            {
                "viewType": "xlsxViewer.tsv",
                "displayName": "Sheetmark — TSV",
                "selector": [
                    {
                        "filenamePattern": "*.tsv"
                    }
                ]
            },
            {
                "viewType": "xlsxViewer.md",
                "displayName": "Sheetmark — Markdown",
                "priority": "option",
                "selector": [
                    {
                        "filenamePattern": "*.md"
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "xlsx-viewer.goBackToMdPreview",
                "title": "Open with Sheetmark",
                "category": "Sheetmark",
                "icon": "resources/md/logo.svg"
            },
            {
                "command": "xlsx-viewer.goBackToTableView",
                "title": "Open with Sheetmark",
                "category": "Sheetmark",
                "icon": "resources/spreadsheet/spreadsheet.svg"
            },
            {
                "command": "xlsx-viewer.goBackToXlsxView",
                "title": "Open with Sheetmark",
                "category": "Sheetmark",
                "icon": "resources/spreadsheet/spreadsheet.svg"
            },
            {
                "command": "xlsx-viewer.convertFile",
                "title": "Convert File...",
                "category": "Sheetmark"
            },
            {
                "command": "xlsx-viewer.openWithXlsx",
                "title": "Open with Sheetmark"
            },
            {
                "command": "xlsx-viewer.openWithCsv",
                "title": "Open with Sheetmark"
            },
            {
                "command": "xlsx-viewer.openWithTsv",
                "title": "Open with Sheetmark"
            },
            {
                "command": "xlsx-viewer.openWithMd",
                "title": "Open with Sheetmark"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "xlsx-viewer.openWithXlsx",
                    "when": "resourceExtname == '.xlsx'",
                    "group": "navigation@100"
                },
                {
                    "command": "xlsx-viewer.openWithCsv",
                    "when": "resourceExtname == '.csv'",
                    "group": "navigation@100"
                },
                {
                    "command": "xlsx-viewer.openWithTsv",
                    "when": "resourceExtname == '.tsv'",
                    "group": "navigation@100"
                },
                {
                    "command": "xlsx-viewer.openWithMd",
                    "when": "resourceExtname == '.md'",
                    "group": "navigation@100"
                }
            ],
            "editor/title/context": [
                {
                    "command": "xlsx-viewer.openWithXlsx",
                    "when": "resourceExtname == '.xlsx'",
                    "group": "navigation@100"
                },
                {
                    "command": "xlsx-viewer.openWithCsv",
                    "when": "resourceExtname == '.csv'",
                    "group": "navigation@100"
                },
                {
                    "command": "xlsx-viewer.openWithTsv",
                    "when": "resourceExtname == '.tsv'",
                    "group": "navigation@100"
                },
                {
                    "command": "xlsx-viewer.openWithMd",
                    "when": "resourceExtname == '.md'",
                    "group": "navigation@100"
                }
            ],
            "editor/title": [
                {
                    "when": "resourceExtname == '.xlsx' && activeEditor != 'xlsxViewer.xlsx'",
                    "command": "xlsx-viewer.goBackToXlsxView",
                    "group": "navigation"
                },
                {
                    "when": "resourceExtname == '.csv' && activeEditor != 'xlsxViewer.csv'",
                    "command": "xlsx-viewer.goBackToTableView",
                    "group": "navigation"
                },
                {
                    "when": "resourceExtname == '.tsv' && activeEditor != 'xlsxViewer.tsv'",
                    "command": "xlsx-viewer.goBackToTableView",
                    "group": "navigation"
                },
                {
                    "when": "(resourceExtname == '.md' || resourceLangId == markdown) && activeEditor != 'xlsxViewer.md'",
                    "command": "xlsx-viewer.goBackToMdPreview",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "Sheetmark",
            "properties": {
                "xlsxViewer.csv.firstRowIsHeader": {
                    "type": "boolean",
                    "default": true,
                    "description": "Treat the first row of CSV files as a header (makes the first row bold)."
                },
                "xlsxViewer.csv.stickyHeader": {
                    "type": "boolean",
                    "default": false,
                    "description": "Make the first row sticky when 'First row is header' is enabled."
                },
                "xlsxViewer.csv.stickyToolbar": {
                    "type": "boolean",
                    "default": true,
                    "description": "Keep the CSV toolbar sticky at the top of the editor."
                },
                "xlsxViewer.csv.autoSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically save CSV edits after a short debounce."
                },
                "xlsxViewer.csv.spaciousCells": {
                    "type": "boolean",
                    "default": false,
                    "description": "Increase cell padding and height for a more spacious view."
                },
                "xlsxViewer.csv.textWrap": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable text wrapping in CSV cells by default."
                },
                "xlsxViewer.tsv.firstRowIsHeader": {
                    "type": "boolean",
                    "default": true,
                    "description": "Treat the first row of TSV files as a header (makes the first row bold)."
                },
                "xlsxViewer.tsv.stickyHeader": {
                    "type": "boolean",
                    "default": false,
                    "description": "Make the first row sticky when 'First row is header' is enabled."
                },
                "xlsxViewer.tsv.stickyToolbar": {
                    "type": "boolean",
                    "default": true,
                    "description": "Keep the TSV toolbar sticky at the top of the editor."
                },
                "xlsxViewer.tsv.autoSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically save TSV edits after a short debounce."
                },
                "xlsxViewer.tsv.spaciousCells": {
                    "type": "boolean",
                    "default": false,
                    "description": "Increase cell padding and height for a more spacious view."
                },
                "xlsxViewer.tsv.textWrap": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable text wrapping in TSV cells by default."
                },
                "xlsxViewer.xlsx.stickyToolbar": {
                    "type": "boolean",
                    "default": true,
                    "description": "Keep the XLSX toolbar sticky at the top of the editor."
                },
                "xlsxViewer.xlsx.firstRowIsHeader": {
                    "type": "boolean",
                    "default": true,
                    "description": "Treat the first row of XLSX files as a header (makes the first row bold)."
                },
                "xlsxViewer.xlsx.stickyHeader": {
                    "type": "boolean",
                    "default": false,
                    "description": "Make the first row sticky when 'First row is header' is enabled."
                },
                "xlsxViewer.xlsx.autoSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically save XLSX edits shortly after text, checkbox, dropdown, formatting, or structure changes."
                },
                "xlsxViewer.xlsx.autoSaveMode": {
                    "type": "string",
                    "default": "all",
                    "enum": [
                        "all",
                        "controlsOnly"
                    ],
                    "description": "Choose whether XLSX autosave applies to all changes or only checkbox/dropdown changes."
                },
                "xlsxViewer.xlsx.showManualSavePopup": {
                    "type": "boolean",
                    "default": true,
                    "description": "When XLSX autosave is off, show a brief reminder popup to save manually after edits."
                },
                "xlsxViewer.xlsx.allowInteractiveControlsOutsideEditMode": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow checkbox and dropdown cells to be edited without entering table edit mode."
                },
                "xlsxViewer.xlsx.hyperlinkPreview": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show a hover tooltip for hyperlinks with Open/Copy actions."
                },
                "xlsxViewer.xlsx.spaciousCells": {
                    "type": "boolean",
                    "default": false,
                    "description": "Increase cell padding and height for a more spacious view."
                },
                "xlsxViewer.xlsx.textWrap": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable text wrapping in XLSX cells by default."
                },
                "xlsxViewer.xlsx.mergeWarningEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show a confirmation popup before merging cells that warns only the top-left cell value is preserved."
                },
                "xlsxViewer.md.stickyToolbar": {
                    "type": "boolean",
                    "default": true,
                    "description": "Keep the Markdown toolbar sticky at the top of the editor."
                },
                "xlsxViewer.md.wordWrap": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable word wrap in the Markdown preview."
                },
                "xlsxViewer.md.showOutline": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the Markdown outline panel in the preview."
                },
                "xlsxViewer.md.showLineNumbers": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show line numbers in code blocks."
                },
                "xlsxViewer.md.livePreviewReveal": {
                    "type": "boolean",
                    "default": true,
                    "description": "In Markdown Preview Edit mode, reveal raw syntax markers (##, **, etc.) near the cursor and hide them elsewhere (Obsidian-style live preview)."
                },
                "xlsxViewer.md.livePreviewLineNumbers": {
                    "type": "boolean",
                    "default": false,
                    "description": "In Markdown Preview Edit mode, show line numbers in the editor gutter."
                },
                "xlsxViewer.md.autoSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically save Markdown edits after a short debounce."
                }
            }
        }
    },
    "scripts": {
        "build": "npm run compile",
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "vscode-test",
        "test:unit": "node --test \"src/webviews/md/**/*.test.mts\""
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/mocha": "^8.2.2",
        "@types/node": "14.x",
        "@types/vscode": "^1.60.0",
        "@typescript-eslint/eslint-plugin": "^8.30.1",
        "@typescript-eslint/parser": "^8.30.1",
        "esbuild": "^0.25.1",
        "eslint": "^9.24.0",
        "mocha": "^11.7.5",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.4.5",
        "vscode-test": "^1.5.2"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.18.6",
        "@codemirror/commands": "^6.8.1",
        "@codemirror/lang-markdown": "^6.3.2",
        "@codemirror/language": "^6.11.0",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/search": "^6.5.10",
        "@codemirror/state": "^6.5.2",
        "@codemirror/view": "^6.36.5",
        "@lezer/markdown": "^1.4.2",
        "@types/highlight.js": "^9.12.4",
        "@types/markdown-it": "^14.1.2",
        "@types/markdown-it-container": "^2.0.11",
        "exceljs": "^4.3.0",
        "highlight.js": "^11.11.1",
        "js-yaml": "^5.2.1",
        "katex": "^0.16.45",
        "markdown-it": "^14.1.0",
        "markdown-it-abbr": "^2.0.0",
        "markdown-it-container": "^4.0.0",
        "markdown-it-deflist": "^3.0.0",
        "markdown-it-emoji": "^3.0.0",
        "markdown-it-footnote": "^4.0.0",
        "markdown-it-ins": "^4.0.0",
        "markdown-it-katex": "^2.0.3",
        "markdown-it-mark": "^4.0.0",
        "markdown-it-sub": "^2.0.0",
        "markdown-it-sup": "^2.0.0",
        "markdown-it-task-lists": "^2.1.1",
        "mermaid": "^11.4.0",
        "typo-js": "^1.3.2"
    },
    "license": "MIT",
    "icon": "icon.png"
}
