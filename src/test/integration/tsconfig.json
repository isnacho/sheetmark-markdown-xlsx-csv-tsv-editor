{
	// Integration tests: run inside a real VS Code extension host (Node), driven by mocha via
	// @vscode/test-cli. Bundled by `node esbuild.js --integration` into out/integration/.
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		"lib": ["ES2020"],
		"types": ["node", "mocha"],
		"strict": true,
		"noUnusedLocals": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["./**/*.ts"]
}
